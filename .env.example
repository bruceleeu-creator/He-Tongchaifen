# ========== 运行模式 ==========
# mock: 使用预设JSON数据; rule: 规则解析优先(无需API Key); auto: 规则优先+LLM增强
RUN_MODE=rule

# ========== 解析模式 ==========
# auto: 规则解析优先,有API Key时LLM增强; rule: 仅规则解析; llm: 仅LLM
PARSER_MODE=auto

# ========== LLM 配置 ==========
# 支持 OpenAI-compatible 接口: DeepSeek / 通义千问 / 其他
# 未配置 API Key 时自动使用规则解析模式
LLM_API_KEY=

# DeepSeek 默认配置（推荐）:
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 通义千问配置（切换时取消注释）:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# OpenAI 配置:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# ========== 应用配置 ==========
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
